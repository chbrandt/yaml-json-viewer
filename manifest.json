{
  "manifest_version": 3,
  "name": "YAML & JSON Pretty Viewer",
  "version": "1.0.0",
  "description": "View JSON and YAML files directly in the browser with pretty printing instead of downloading them.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "prevent_downloads",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*/*.json*", "*://*/*.yml*", "*://*/*.yaml*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon_16.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  }
}
